# ============================================================
#  Локализации: UTF-8 с BOM, 11 языков
#  Файлы должны сохраняться БАЙТ-В-БАЙТ, включая BOM (EF BB BF).
# ============================================================

# -text = Git не делает никаких преобразований:
#   не нормализует EOL, не трогает кодировку, не срезает BOM.
#   Файл хранится и отдаётся ровно таким, каким был добавлен.
*.utf8 -text

# Служебные файлы репозитория — обычный текст
.gitattributes  text eol=lf
.gitignore      text eol=lf
README.md       text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf